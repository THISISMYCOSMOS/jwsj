{
  "manifest_version": 3,
  "name": "지우사랑해",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Groq로 강의를 받아쓰고, 본인 Claude/Codex 계정으로 선택한 강의의 요약 노트를 만듭니다.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "nativeMessaging",
    "downloads",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://lcms.skku.edu/*",
    "https://vod.skku.edu/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/heart-16.png",
    "32": "icons/heart-32.png",
    "48": "icons/heart-48.png",
    "128": "icons/heart-128.png"
  },
  "action": {
    "default_title": "지우사랑해 패널 열기",
    "default_icon": {
      "16": "icons/heart-16.png",
      "32": "icons/heart-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "js": [
        "content/klas-status.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://canvas.skku.edu/learningx/lti/modulebuilder*"
      ],
      "js": [
        "content/skku-list.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lcms.skku.edu/em/*",
        "https://lcms.skku.edu/viewer/ssplayer/*"
      ],
      "js": [
        "content/kw-player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "note-launch.html"
      ],
      "matches": [
        "file:///*"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
